POSTGRES_USER=relay
POSTGRES_PASSWORD=relay
POSTGRES_DB=relay

DATABASE_URL=postgresql://relay:relay@db:5432/relay

CORS_ORIGINS=http://localhost:5173

VITE_API_URL=http://localhost:8000

# Habilita GET /metrics quando definido. Vazio = endpoint desabilitado.
METRICS_TOKEN=

# Teto de submissões por empresa por minuto.
RATE_LIMIT_PER_MINUTE=300

# Teto de empresas nas séries de /metrics, para conter cardinalidade.
METRICS_MAX_TENANTS=100

# Janela das falhas por classe de erro em /metrics.
METRICS_FAILURE_WINDOW_MINUTES=60

# Reserva do job no worker, em segundos. Renovada enquanto o job roda, então
# este valor é apenas quanto tempo um job fica preso se o worker morrer.
LEASE_SECONDS=30

# Quantidade de workers. A claim usa FOR UPDATE SKIP LOCKED, então réplicas
# concorrem pela fila sem coordenação externa.
WORKER_REPLICAS=1
